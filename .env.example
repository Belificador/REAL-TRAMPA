# Copia este archivo a ".env" y completa los valores.
# El servidor local (servidor.py) los lee e inyecta la config de Supabase
# al navegador. Sin estas variables, el juego sigue funcionando en modo
# offline (récords en localStorage).

# URL del proyecto (Settings > API > Project URL).
SUPABASE_URL=

# Clave pública para el navegador (Settings > API > anon/public).
SUPABASE_ANON_KEY=

# Clave de servidor SOLO para el endpoint protegido de borrado
# (Settings > API > service_role). Nunca la expongas en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Token secreto del endpoint POST /api/highscores/limpiar (inventa uno fuerte).
SUPABASE_ADMIN_TOKEN=